@page "/SongTier"
@inject HttpClient Http

<PageTitle>曲Tier</PageTitle>

<h1>曲Tier</h1>

@if (!isTableVisible)
{
    <p>曲Tierを作れます</p>
    <p>Tire列からTierを選択してください</p>
    <p>選択した曲のみTier表に反映されます</p>
}
else
{
    <p>あなたのとき宣曲Tier表</p>
}

@if (songs == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!isTableVisible){
        <table class="table">
            <thead>
                <tr>
                    <th>曲名</th>
                    <th>Tire</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in songs)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>
                            <select @bind="item.SelectedOption">
                                @foreach (var option in options)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @*         <style>
            table th {
                border-bottom: solid 2px #fb5144;
                text-align: center;
                padding: 10px 0;
            }

            table td {
                border-bottom: solid 2px #ddd;
                text-align: center;
                padding: 10px 0;
            }


            table {
                width: 100%;
                border-spacing: 0;
            }
        </style> *@

        @* <div class="chart-container" style="position: relative; height:400px; width:600px">
            <canvas id="myChart"></canvas>
        </div> *@

        <button class="btn btn-primary" @onclick="OnClick">作成</button>
        @* <button class="btn btn-primary btn-sm py-0" onclick="renderChartTest()">Click me</button> *@
    }else
    {
        <table class="table" style="width: 100%; max-width: 100%;">
            <thead>
                <tr>
                    <th>Tire</th>
                    <th>曲名</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in results)
                {
                    <tr>
                        <td>@item.Tier</td>
                        <td>@((MarkupString)item.Song)</td>
                    </tr>
                }
            </tbody>
        </table>




        @*  <style>
            table th {
                border-bottom: solid 2px #fb5144;
                text-align: center;
                padding: 10px 0;
            }

            table td {
                border-bottom: solid 2px #ddd;
                text-align: center;
                padding: 10px 0;
            }

            table {
                width: 100%;
                border-spacing: 0;
            }
        </style> *@


    }

}

