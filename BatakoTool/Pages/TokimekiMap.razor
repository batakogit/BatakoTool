    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initMap");

        foreach (var marker in TourMarkers)
        {
            await JS.InvokeVoidAsync("addMarker", marker.Latitude, marker.Longitude, marker.PopupText, marker.DestinationName, marker.Color, marker.IsBlinking);
        }

        await JS.InvokeVoidAsync("zoomToMarkers");
    }

    public class MapMarker
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string PopupText { get; set; } = string.Empty;
        public string DestinationName { get; set; } = string.Empty;
        public string Color { get; set; } = "red";
        public bool IsBlinking { get; set; } = false;
    }

@* @if (kumichos == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>タイトル</th>
                <th>組長賞</th>
                <th>1等</th>
                <th>2等</th>
                <th>3等</th>
                <th>4等</th>
                <th>5等</th>
                <th>ときめき賞</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in kumichos)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.KumichoSho</td>
                    <td>@item.One</td>
                    <td>@item.Two</td>
                    <td>@item.Three</td>
                    <td>@item.Four</td>
                    <td>@item.Five</td>
                    <td>@item.TokimekiSho</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Kumicho[]? kumichos;

    protected override async Task OnInitializedAsync()
    {
        kumichos = await Http.GetFromJsonAsync<Kumicho[]>("sample-data/weather.json");
    }

    public class Kumicho
    {
        public string? Title { get; set; }

        public string? KumichoSho { get; set; }

        public string? One { get; set; }

        public string? Two { get; set; }

        public string? Three { get; set; }

        public string? Four { get; set; }

        public string? Five { get; set; }

        public string? TokimekiSho { get; set; }
    } *@
}
